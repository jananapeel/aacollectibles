<section class="sec" id="sell">
  <div class="wrap">
    <div class="sell bracket">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.body }}</p>
        {%- if section.blocks.size > 0 -%}
          <div class="offers">
            {%- for block in section.blocks -%}
              <div {{ block.shopify_attributes }}>
                <b>{{ block.settings.figure }}</b><span>{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <a class="btn btn-gold" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sell to us",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Got a binder collecting dust?" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get a quote" },
    { "type": "url", "id": "cta_url", "label": "Button link",
      "info": "Point this at the buylist page once it exists." }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Figure",
      "settings": [
        { "type": "text", "id": "figure", "label": "Figure", "default": "Cash" },
        { "type": "text", "id": "label", "label": "Caption", "default": "paid on the spot" }
      ]
    }
  ],
  "presets": [
    { "name": "Sell to us", "blocks": [ { "type": "offer" }, { "type": "offer" }, { "type": "offer" } ] }
  ]
}
{% endschema %}
