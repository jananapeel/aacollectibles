<div class="topline"></div>

{%- if section.blocks.size > 0 -%}
<div class="tape">
  <div class="tape-inner">
    <div class="tape-tag">{{ section.settings.label }}</div>
    <div class="tape-track">
      <div class="tape-run">
        {%- for block in section.blocks -%}
          <span class="tape-item" {{ block.shopify_attributes }}>
            <b>{{ block.settings.kicker }}</b>{{ block.settings.text }}
            {%- if block.settings.note != blank %} <i>{{ block.settings.note }}</i>{% endif -%}
          </span>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Counter strip",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Strip label",
      "default": "At the counter"
    },
    {
      "type": "paragraph",
      "content": "Shop news only. Avoid price movement, countdowns or live stock counts — they read as fake urgency."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Strip item",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "info": "The small gold caps. e.g. New in, Restocked, Preorder open",
          "default": "New in"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Umbreon VMAX alt art, PSA 10"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Trailing note",
          "info": "Optional. Set in mono — good for a price."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Counter strip",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
