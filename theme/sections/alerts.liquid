<section class="sec" style="padding-top:0">
  <div class="wrap alerts">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.say != blank -%}
        <p class="say" style="margin-top:13px">{{ section.settings.say }}</p>
      {%- endif -%}

      {% form 'customer', class: 'sub-form', id: 'subForm' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="sr" for="subEmail">Email address</label>
        <input id="subEmail" type="email" name="contact[email]"
               placeholder="you@example.com" autocomplete="email" required>
        <button class="btn btn-gold" type="submit">{{ section.settings.button | default: 'Notify me' }}</button>

        {%- if form.posted_successfully? -%}
          <p class="fine" style="width:100%">You're on the list. Drop alerts are on their way.</p>
        {%- elsif form.errors -%}
          <p class="fine" style="width:100%;color:var(--down)">
            {{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
      {% endform %}

      <p class="fine">{{ section.settings.fine }}</p>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="cal">
        <div class="cal-head">
          <strong>{{ section.settings.cal_title }}</strong>
          {%- if section.settings.cal_tag != blank -%}
            <span class="tag">{{ section.settings.cal_tag }}</span>
          {%- endif -%}
        </div>
        <ul>
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="date">{{ block.settings.date }}</span>
              <span class="title">
                {{ block.settings.title }}
                <small>{{ block.settings.meta }}</small>
              </span>
              <span class="tag">{{ block.settings.status }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Restock alerts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Restock alerts" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Know before the box sells out" },
    { "type": "text", "id": "say", "label": "Sub-heading" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "fine", "label": "Small print",
      "default": "No spam, no list sales. Unsubscribe in one click." },
    { "type": "header", "content": "Release calendar" },
    { "type": "text", "id": "cal_title", "label": "Panel title", "default": "On the calendar" },
    { "type": "text", "id": "cal_tag", "label": "Panel tag",
      "info": "Clear this once the dates are real.", "default": "Sample data" }
  ],
  "blocks": [
    {
      "type": "date",
      "name": "Calendar row",
      "settings": [
        { "type": "text", "id": "date", "label": "Date", "default": "SEP 26" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "meta", "label": "Sub-line", "info": "Game and product type." },
        { "type": "text", "id": "status", "label": "Status", "default": "Preorder" }
      ]
    }
  ],
  "presets": [
    { "name": "Restock alerts",
      "blocks": [ { "type": "date" }, { "type": "date" }, { "type": "date" } ] }
  ]
}
{% endschema %}
