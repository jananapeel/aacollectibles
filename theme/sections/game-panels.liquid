<section class="sec">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.say != blank -%}<p class="say">{{ section.settings.say }}</p>{%- endif -%}
      </div>
      {%- if section.settings.more_url != blank -%}
        <a class="link-more" href="{{ section.settings.more_url }}">{{ section.settings.more_label }}</a>
      {%- endif -%}
    </div>

    <div class="games">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection] -%}
        <article class="game" {{ block.shopify_attributes }}>
          <div class="game-top">
            <span class="idx">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3>{{ block.settings.title | default: col.title }}</h3>
            <p class="sub">{{ block.settings.blurb }}</p>
            {%- if block.settings.chip != blank -%}
              <span class="chip"><i></i>{{ block.settings.chip }}</span>
            {%- endif -%}
          </div>
          <ul class="game-body">
            {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
            {%- for row in rows -%}
              {%- assign parts = row | strip | split: '|' -%}
              {%- if parts.size > 0 and parts[0] != blank -%}
                <li><b>{{ parts[0] | strip }}</b><span class="n">{{ parts[1] | strip }}</span></li>
              {%- endif -%}
            {%- endfor -%}
            <a class="game-cta" href="{{ col.url | default: block.settings.url }}">
              {{ block.settings.cta | default: 'Shop' }} &rarr;
            </a>
          </ul>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Game panels",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Three games, one counter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your side of the case" },
    { "type": "text", "id": "say", "label": "Sub-heading" },
    { "type": "text", "id": "more_label", "label": "Corner link label", "default": "Browse everything" },
    { "type": "url", "id": "more_url", "label": "Corner link" }
  ],
  "blocks": [
    {
      "type": "game",
      "name": "Game",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "textarea", "id": "blurb", "label": "Blurb" },
        { "type": "text", "id": "chip", "label": "Gold chip", "info": "e.g. Now stocking · Prismatic Evolutions" },
        { "type": "textarea", "id": "rows", "label": "Stat rows",
          "info": "One per line, as: Label | Value" },
        { "type": "text", "id": "cta", "label": "Button label", "default": "Shop" },
        { "type": "url", "id": "url", "label": "Button link (if no collection)" }
      ]
    }
  ],
  "presets": [
    { "name": "Game panels", "blocks": [ { "type": "game" }, { "type": "game" }, { "type": "game" } ] }
  ]
}
{% endschema %}
