<section class="sec proc" id="grading">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.say != blank -%}<p class="say">{{ section.settings.say }}</p>{%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <div class="step" {{ block.shopify_attributes }}>
        <div class="num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.body }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Process steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From intake to mailbox" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How a card gets to you" },
    { "type": "text", "id": "say", "label": "Sub-heading" },
    { "type": "paragraph", "content": "Steps are numbered automatically — they are a real sequence, so order matters." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Loupe check" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [
    { "name": "Process steps",
      "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" } ] }
  ]
}
{% endschema %}
