<section class="page-head">
  <div class="wrap">
    <nav class="crumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><b style="color:var(--mist)">Search</b></nav>
    <div class="page-title">
      <div>
        <p class="pub">Search the case</p>
        <h1>{% if search.performed %}{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }}{% else %}Find a card{% endif %}</h1>
      </div>
    </div>

    <form class="sub-form" action="{{ routes.search_url }}" method="get" role="search" style="max-width:620px">
      <label class="sr" for="q">Search</label>
      <input id="q" type="search" name="q" value="{{ search.terms | escape }}"
             placeholder="Card name, set code, or player" autocomplete="off">
      <button class="btn btn-gold" type="submit">Search</button>
    </form>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <div class="listings">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- else -%}
            <p class="no-results">
              Nothing matched &ldquo;{{ search.terms | escape }}&rdquo;. Try the set code, or just the card name.
            </p>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pager" role="navigation" aria-label="Pagination">
            {%- if paginate.previous -%}<a class="btn btn-line" href="{{ paginate.previous.url }}">&larr; Previous</a>{%- endif -%}
            <span class="pager-at">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a class="btn btn-line" href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>
